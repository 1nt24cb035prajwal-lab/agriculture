APP_ENV=dev                 # dev = OTPs are printed to the server console. Use "prod" in production.
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./atf.db      # or postgresql+psycopg2://user:pass@host/db
CORS_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword1
NOMINATIM_EMAIL=you@example.com      # required by OpenStreetMap usage policy

# SMS OTP (Twilio). Without these, OTP only works when APP_ENV=dev (printed to console).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Google sign-in (OAuth client id from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Market prices: free API key from https://data.gov.in (Agmarknet daily prices resource)
DATA_GOV_API_KEY=

# Satellite NDVI: Sentinel Hub OAuth client (https://apps.sentinel-hub.com/dashboard)
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=

# Disease model confidence below this => "uncertain, upload another image"
DISEASE_MIN_CONFIDENCE=0.80
SUPPLIER_URL=https://share.google/tCbEJZtVxZKIURC8C
